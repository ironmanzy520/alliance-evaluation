{
  "$defs": {
    "ActivityAgreementRatedFinding": {
      "additionalProperties": false,
      "description": "Events of agreement or disagreement between both parties about a specific Activity or its steps.\n\nAgreement is an explicit core term in Bordin (1979) and Horvath and Greenberg (1989).\nClear agreement, partial agreement and clear disagreement are dialogue-text codes.",
      "properties": {
        "dimension": {
          "const": "Activity agreement/disagreement",
          "title": "Dimension",
          "type": "string"
        },
        "activity_reference": {
          "$ref": "#/$defs/ActivityReference"
        },
        "finding_status": {
          "const": "rated",
          "title": "Finding Status",
          "type": "string"
        },
        "rating_label": {
          "enum": [
            "Clear activity disagreement",
            "Partial or conditional activity agreement",
            "Clear activity agreement"
          ],
          "title": "Rating Label",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "activity_reference",
        "finding_status",
        "rating_label",
        "evidence",
        "reason"
      ],
      "title": "ActivityAgreementRatedFinding",
      "type": "object"
    },
    "ActivityEfficacyRatedFinding": {
      "additionalProperties": false,
      "description": "Client judgements explicitly expressing the helpfulness of a specific Activity.\n\nEfficacy/helpfulness follows Horvath and Greenberg (1989). The three event\ncategories are project text codes recording client views, not objective clinical effects.",
      "properties": {
        "dimension": {
          "const": "Client-expressed activity efficacy",
          "title": "Dimension",
          "type": "string"
        },
        "activity_reference": {
          "$ref": "#/$defs/ActivityReference"
        },
        "finding_status": {
          "const": "rated",
          "title": "Finding Status",
          "type": "string"
        },
        "rating_label": {
          "enum": [
            "Clear client-perceived inefficacy",
            "Mixed or uncertain client-perceived efficacy",
            "Clear client-perceived efficacy"
          ],
          "title": "Rating Label",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "activity_reference",
        "finding_status",
        "rating_label",
        "evidence",
        "reason"
      ],
      "title": "ActivityEfficacyRatedFinding",
      "type": "object"
    },
    "ActivityReference": {
      "additionalProperties": false,
      "description": "An Activity ID reused consistently within a sample, with a label favouring the source wording.",
      "properties": {
        "activity_id": {
          "pattern": "^ACTIVITY_[0-9]{2,}$",
          "title": "Activity Id",
          "type": "string"
        },
        "activity_label": {
          "minLength": 1,
          "title": "Activity Label",
          "type": "string"
        }
      },
      "required": [
        "activity_id",
        "activity_label"
      ],
      "title": "ActivityReference",
      "type": "object"
    },
    "ActivityRelevanceRatedFinding": {
      "additionalProperties": false,
      "description": "Events in which the client explicitly expresses the relevance of a specific Activity.\n\nRelevance follows Horvath and Greenberg (1989). The three event categories are\nproject text codes, not WAI scores.",
      "properties": {
        "dimension": {
          "const": "Client-expressed activity relevance",
          "title": "Dimension",
          "type": "string"
        },
        "activity_reference": {
          "$ref": "#/$defs/ActivityReference"
        },
        "finding_status": {
          "const": "rated",
          "title": "Finding Status",
          "type": "string"
        },
        "rating_label": {
          "enum": [
            "Clear client-perceived irrelevance",
            "Mixed or conditional client-perceived relevance",
            "Clear client-perceived relevance"
          ],
          "title": "Rating Label",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "activity_reference",
        "finding_status",
        "rating_label",
        "evidence",
        "reason"
      ],
      "title": "ActivityRelevanceRatedFinding",
      "type": "object"
    },
    "ClientBondSummaryEvidenceFinding": {
      "additionalProperties": false,
      "description": "Dyadic Mutual trust and respect evidence available from a client turn.",
      "properties": {
        "dimension": {
          "const": "Mutual trust and respect",
          "title": "Dimension",
          "type": "string"
        },
        "activity_reference": {
          "title": "Activity Reference",
          "type": "null"
        },
        "finding_status": {
          "const": "evidence_only",
          "title": "Finding Status",
          "type": "string"
        },
        "rating_label": {
          "title": "Rating Label",
          "type": "null"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "activity_reference",
        "finding_status",
        "rating_label",
        "evidence",
        "reason"
      ],
      "title": "ClientBondSummaryEvidenceFinding",
      "type": "object"
    },
    "ClientEngagementEvidenceFinding": {
      "additionalProperties": false,
      "description": "Client-turn WT5 evidence for a specific Activity; ratings are assigned at summary level (Eubanks & Muran, 2022).",
      "properties": {
        "dimension": {
          "const": "Client engagement in the activity",
          "title": "Dimension",
          "type": "string"
        },
        "activity_reference": {
          "$ref": "#/$defs/ActivityReference"
        },
        "finding_status": {
          "const": "evidence_only",
          "title": "Finding Status",
          "type": "string"
        },
        "rating_label": {
          "title": "Rating Label",
          "type": "null"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "activity_reference",
        "finding_status",
        "rating_label",
        "evidence",
        "reason"
      ],
      "title": "ClientEngagementEvidenceFinding",
      "type": "object"
    },
    "ConfirmationRatedFinding": {
      "additionalProperties": false,
      "description": "Turn-level interaction events for Client confirmation/disconfirmation.\n\nConfirmation/disconfirmation sequences follow Elliott et al. (2023). The three\ntextual categories are project codes for the available dialogue evidence.",
      "properties": {
        "dimension": {
          "const": "Client confirmation/disconfirmation",
          "title": "Dimension",
          "type": "string"
        },
        "activity_reference": {
          "title": "Activity Reference",
          "type": "null"
        },
        "finding_status": {
          "const": "rated",
          "title": "Finding Status",
          "type": "string"
        },
        "rating_label": {
          "enum": [
            "Clear confirmation",
            "Partial confirmation",
            "Clear disconfirmation"
          ],
          "title": "Rating Label",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "activity_reference",
        "finding_status",
        "rating_label",
        "evidence",
        "reason"
      ],
      "title": "ConfirmationRatedFinding",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "A verifiable evidence span containing only its source turn ID and exact quote.",
      "properties": {
        "turn_id": {
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "PerceivedAcceptanceRatedFinding": {
      "additionalProperties": false,
      "description": "Events in which the client explicitly expresses perceived acceptance.\n\nThe theoretical role of client perception follows Rogers (1957/1992) and Barrett-Lennard\n(1962). The three textual categories are project adaptations, not Relationship Inventory scores.",
      "properties": {
        "dimension": {
          "const": "Client-perceived acceptance",
          "title": "Dimension",
          "type": "string"
        },
        "activity_reference": {
          "title": "Activity Reference",
          "type": "null"
        },
        "finding_status": {
          "const": "rated",
          "title": "Finding Status",
          "type": "string"
        },
        "rating_label": {
          "enum": [
            "Clear perceived acceptance",
            "Mixed/conditional perceived acceptance",
            "Clear perceived non-acceptance"
          ],
          "title": "Rating Label",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "activity_reference",
        "finding_status",
        "rating_label",
        "evidence",
        "reason"
      ],
      "title": "PerceivedAcceptanceRatedFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Speaker-specific structured output for the current client turn.",
  "properties": {
    "findings": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/ConfirmationRatedFinding"
          },
          {
            "$ref": "#/$defs/PerceivedAcceptanceRatedFinding"
          },
          {
            "$ref": "#/$defs/ActivityAgreementRatedFinding"
          },
          {
            "$ref": "#/$defs/ActivityRelevanceRatedFinding"
          },
          {
            "$ref": "#/$defs/ActivityEfficacyRatedFinding"
          },
          {
            "$ref": "#/$defs/ClientBondSummaryEvidenceFinding"
          },
          {
            "$ref": "#/$defs/ClientEngagementEvidenceFinding"
          }
        ]
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "findings"
  ],
  "title": "ClientTurnLLMOutput",
  "type": "object"
}
