{
  "$defs": {
    "AcceptanceValidationSummary": {
      "additionalProperties": false,
      "description": "WT3 acceptance/validation stance for the complete sample (Eubanks & Muran, 2022).",
      "properties": {
        "dimension": {
          "const": "Therapist accepts/validates Patient",
          "title": "Dimension",
          "type": "string"
        },
        "activity_reference": {
          "title": "Activity Reference",
          "type": "null"
        },
        "summary_status": {
          "const": "rated",
          "title": "Summary Status",
          "type": "string"
        },
        "rating_label": {
          "enum": [
            "Not salient",
            "Somewhat salient",
            "Very salient"
          ],
          "title": "Rating Label",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "counterevidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Counterevidence",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "activity_reference",
        "summary_status",
        "rating_label",
        "evidence",
        "counterevidence",
        "reason"
      ],
      "title": "AcceptanceValidationSummary",
      "type": "object"
    },
