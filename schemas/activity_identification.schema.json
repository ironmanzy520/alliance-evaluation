{
  "$defs": {
    "ActivityReference": {
      "additionalProperties": false,
      "description": "An Activity ID reused consistently within a sample, with a label favouring the source wording.",
      "properties": {
        "activity_id": {
          "pattern": "^ACTIVITY_[0-9]{2,}$",
          "title": "Activity Id",
          "type": "string"
        },
        "activity_label": {
          "minLength": 1,
          "title": "Activity Label",
          "type": "string"
        }
      },
      "required": [
        "activity_id",
        "activity_label"
      ],
      "title": "ActivityReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Activity identification returns only newly registered specific therapeutic work in the current turn.",
  "properties": {
    "new_activities": {
      "items": {
        "$ref": "#/$defs/ActivityReference"
      },
      "title": "New Activities",
      "type": "array"
    }
  },
  "required": [
    "new_activities"
  ],
  "title": "ActivityIdentificationLLMOutput",
  "type": "object"
}
